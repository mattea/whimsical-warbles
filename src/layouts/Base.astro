---
import '@retropolis/ui/styles.css';
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import ControlDeck from '../components/ControlDeck.tsx';
import StatusBeacon from '../components/StatusBeacon.tsx';
import Screensaver from '../components/Screensaver.tsx';
import CursorCompanion from '../components/CursorCompanion.tsx';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Pugglenaut',
  description = 'The home planet of Pugglenaut — a whimsical corner of the personal web.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Pugglenaut · Logbook" href="/rss.xml" />

    <!-- Apply the saved theme and (opt-in) time-sky before paint, so neither
         flashes. Paper is the default; CRT/Sketch are opt-in via the theme lab.
         With no saved theme we honor the OS dark preference (→ CRT). -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('pugglenaut-theme');
          if (t === 'crt' || t === 'sketch') {
            document.documentElement.setAttribute('data-rp-theme', t);
          } else if (!t && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.setAttribute('data-rp-theme', 'crt');
          }
          if (localStorage.getItem('pugglenaut-fx-sky') === 'on') {
            var h = new Date().getHours();
            var b = h >= 5 && h < 8 ? 'dawn' : h >= 8 && h < 17 ? 'day' : h >= 17 && h < 20 ? 'dusk' : 'night';
            document.documentElement.setAttribute('data-sky', b);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-top">
      <div class="site-top-inner">
        <a href="/" class="brand" aria-label="Pugglenaut home">
          <span class="brand-mark" aria-hidden="true">🛰️</span>
          <span class="brand-name">pugglenaut</span>
        </a>
        <StatusBeacon client:load />
        <SiteNav />
        <ControlDeck client:load />
      </div>
    </header>

    <slot />

    <!-- Opt-in After Dark-style screensaver (off by default; toggled from the
         control deck or the `screensaver` console command). Renders nothing
         until it idles in. -->
    <Screensaver client:idle />

    <!-- Opt-in cursor companion (off by default; toggled from the control deck
         or the `companion` console command). Fine-pointer devices only. -->
    <CursorCompanion client:idle />

    <footer class="site-foot">
      <span>Made on the small web · {year}</span>
      <nav class="site-foot-links" aria-label="Footer">
        <a href="/contact">Contact</a>
        <a href="/guestbook">Guestbook</a>
        <a href="/rss.xml">RSS</a>
      </nav>
      <span class="site-foot-hint">psst — press <kbd>`</kbd> for mission control</span>
    </footer>
  </body>
</html>
