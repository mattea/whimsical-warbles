---
import '@retropolis/ui/styles.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Pugglenaut',
  description = 'The home planet of Pugglenaut — a whimsical corner of the personal web.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Apply the saved theme before paint to avoid a flash. Light ("Paper")
         is the default; CRT is the opt-in dark phosphor theme. With no saved
         choice we honor the OS preference. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('pugglenaut-theme');
          var crt =
            saved === 'crt' ||
            (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (crt) document.documentElement.setAttribute('data-rp-theme', 'crt');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
