---
import Base from '../layouts/Base.astro';
import LaunchControl from '../components/LaunchControl.tsx';
import PuggleTelemetry from '../components/PuggleTelemetry.tsx';
import VisitorCounter from '../components/VisitorCounter.tsx';
import BoopMascot from '../components/BoopMascot.tsx';
import CosmicRadio from '../components/CosmicRadio.tsx';
import StarMap from '../components/StarMap.astro';
import { Window, Card, Badge, Marquee, Divider, HyperLink } from '@retropolis/ui';
---

<Base>
  <main class="page stack">
    <Marquee speed={16}>
      ✦ Welcome to pugglenaut.com — now boarding for low orbit ✦ built with Astro
      &amp; the Retropolis design system ✦ mind the cosmic dust ✦
    </Marquee>

    <header class="stack" style="gap: 8px;">
      <h1 class="hero-title">Pugglenaut</h1>
      <p class="hero-tagline">
        A baby platypus, in space. This is home base — a whimsical corner of the
        personal web.
      </p>
      <div class="cluster">
        <Badge tone="magenta" blink>new!</Badge>
        <Badge tone="teal">v0.1</Badge>
        <Badge tone="violet">astro + retropolis</Badge>
      </div>
    </header>

    <div class="cluster" style="justify-content: center;">
      <BoopMascot client:visible />
    </div>

    <Window title="navigation.chart" icon="star" status="Pick a star to set course.">
      <StarMap />
    </Window>

    <div class="two-col">
      <Window title="launch-bay.exe" icon="rocket" status="Systems nominal.">
        <div class="stack" style="gap: 12px;">
          <p style="margin: 0;">
            The launch bay is an interactive React island — everything else on
            this page renders to static HTML and ships no JavaScript.
          </p>
          <LaunchControl client:visible />
        </div>
      </Window>

      <Window title="life-support.sys" icon="heart" status="All readings green.">
        <PuggleTelemetry client:visible />
      </Window>
    </div>

    <Window title="cosmic-radio.fm" icon="music" status="Synthesized live — no audio files.">
      <CosmicRadio client:visible />
    </Window>

    <Divider variant="rainbow" label="the neighborhood" />

    <section class="card-grid">
      <Card title="Logbook" icon="pencil" tone="violet">
        <p style="margin: 0 0 12px;">
          Dispatches from orbit — dev notes, doodles, and the occasional warble
          into the void.
        </p>
        <HyperLink href="/logbook">Open the logbook →</HyperLink>
      </Card>
      <Card title="Arcade" icon="rocket" tone="sunshine">
        <p style="margin: 0 0 12px;">
          Two tiny games: dodge asteroids in <em>Puggle Drift</em>, or grow a
          comet in <em>Comet Snake</em>. High-score chasing, one puggle.
        </p>
        <HyperLink href="/game">Enter the arcade →</HyperLink>
      </Card>
      <Card title="Oracle" icon="sparkle" tone="sunshine">
        <p style="margin: 0 0 12px;">
          Ask the cosmos a yes/no question and let a very small platypus divine
          your fate.
        </p>
        <HyperLink href="/oracle">Consult the cosmos →</HyperLink>
      </Card>
      <Card title="Etch-a-Comet" icon="pencil" tone="teal">
        <p style="margin: 0 0 12px;">
          A pixel paint pad. Doodle a comet, then beam a PNG down to your machine.
        </p>
        <HyperLink href="/doodle">Open the doodle pad →</HyperLink>
      </Card>
      <Card title="Guestbook" icon="chat" tone="magenta">
        <p style="margin: 0 0 12px;">
          Sign the wall. Leave a mark before you drift onward.
        </p>
        <HyperLink href="/guestbook">Sign the guestbook →</HyperLink>
      </Card>
      <Card title="Star Charts" icon="star" tone="teal">
        <p style="margin: 0 0 12px;">
          Some favorite links across the small web. Bring your own
          telescope.
        </p>
        <HyperLink href="/links">View the charts →</HyperLink>
      </Card>
      <Card title="Signal" icon="mail" tone="violet">
        <p style="margin: 0 0 12px;">
          Beam a message across the void, or say hi the old-fashioned way at
          <HyperLink href="mailto:hello@pugglenaut.com">hello@pugglenaut.com</HyperLink>.
        </p>
        <HyperLink href="/contact">Open a channel →</HyperLink>
      </Card>
    </section>

    <div class="cluster" style="justify-content: center;">
      <VisitorCounter client:visible page="home" label="pugglenauts aboard" />
    </div>

    <Divider variant="dashed" />

    <section class="stack" style="gap: 8px;">
      <p class="hero-tagline" style="margin: 0;">
        Poke around: flip the <strong>theme lab</strong> up top, tint the sky to
        your local hour, or press <kbd>`</kbd> to open mission control. There may
        be a cheat code or two hiding in here. 🛰️
      </p>
    </section>
  </main>
</Base>
