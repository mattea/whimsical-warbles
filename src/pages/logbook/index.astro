---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { Card, Badge, Tag, Divider, HyperLink } from '@retropolis/ui';

const entries = (await getCollection('logbook', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.stardate.getTime() - a.data.stardate.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title="Logbook · Pugglenaut" description="Transmissions from orbit — dev notes, doodles, and warbles into the void.">
  <main class="page stack">
    <header class="stack" style="gap: 8px;">
      <h1 class="hero-title" style="font-size: clamp(2rem, 6vw, 3.2rem);">Logbook</h1>
      <p class="hero-tagline" style="margin: 0;">
        Transmissions from orbit — dev notes, doodles, and the occasional warble
        into the void.
      </p>
    </header>

    <Divider variant="rainbow" />

    {
      entries.length === 0 ? (
        <p class="hero-tagline">No transmissions yet. Check back after the next flyby.</p>
      ) : (
        <section class="stack" style="gap: 20px;">
          {entries.map((entry) => (
            <Card title={entry.data.title} icon="pencil" tone="violet">
              <div class="stack" style="gap: 10px;">
                <div class="cluster">
                  <Badge tone="teal">stardate {fmt(entry.data.stardate)}</Badge>
                  {entry.data.tags.map((t) => (
                    <Tag tone="violet">{t}</Tag>
                  ))}
                </div>
                <p style="margin: 0;">{entry.data.summary}</p>
                <HyperLink href={`/logbook/${entry.id}`}>Read transmission →</HyperLink>
              </div>
            </Card>
          ))}
        </section>
      )
    }

    <Divider variant="dashed" />

    <p class="site-footer" style="margin: 0;">
      <HyperLink href="/">← back to home base</HyperLink>
    </p>
  </main>
</Base>
